import javafx.scene.paint.Color;
import javafx.stage.Stage;

public class Exercicio22_SlidersBindingBidireccional extends Application{
			
			public void start(Stage stage) throws Exception {
					
				//Creamos los slider 
				Slider sliderH = new Slider();
				Slider sliderV = new Slider();
								
				Orientation sliderH1 = (Orientation.VERTICAL);
				Orientation sliderV2 = (Orientation.HORIZONTAL);
				
				VBox root = new VBox(sliderH);
				root.setBackground(Background.EMPTY);
				root.setAlignment(Pos.CENTER);
				
				/*/ObjectBinding<Paint> objectBindingPaint = Bindings.createObjectBinding(
						() -> btn.isPressed() ? Color.MAGENTA :Color.AQUA,
						btn.pressedProperty()
				);*/
				
				//Creamos la escena
				Scene scene = new Scene(root, 300, 250);
				//scene.fillProperty().bind(objectBindingPaint);
				
				//Hacemos que la escena cambie los colores al pulsar el boton
				scene.fillProperty().bind(Bindings.when(sliderH.pressedProperty()).then(Color.AQUA).otherwise(Color.MAGENTA));
				stage.setTitle("Exercicio 21 Binding helper");
				stage.setScene(scene);
				stage.show();
			}

			public static void main(String[] args) {
				launch();
			}
		}


